# Dipakai saat `npm run build` (mode production) — di-commit karena BUKAN rahasia
# (cuma URL API publik). Vite mem-bake nilai ini ke bundle saat build.
#
# Cloudflare Pages: kalau nanti API pindah host, cukup ubah nilai ini DAN/ATAU
# set Environment Variable VITE_API_BASE_URL di dashboard Pages (Production).
# Nilai di dashboard menang saat build di Cloudflare.
#
# Catatan: .env.local (untuk dev lokal) di-gitignore lewat pola *.local, jadi
# tidak ikut ke repo. Untuk produksi, file .env.production inilah sumbernya.
VITE_API_BASE_URL=https://jalu-finance.shelterdev.online/api/v1
